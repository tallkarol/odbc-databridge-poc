# Database Configuration
# Copy this file to .env and fill in your actual values

# Cloud SQL instance IP address or connection name
# For public IP: use the IP address directly (e.g., 34.123.45.67)
# For private IP: use the private IP address
# For Cloud SQL Proxy: use 127.0.0.1
DB_HOST=your-cloud-sql-ip-or-localhost

# Database port (default MySQL port)
DB_PORT=3306

# Database name
DB_NAME=odbc_poc_db

# Database user
DB_USER=your-db-user

# Database password
DB_PASSWORD=your-db-password

# Application port (optional, defaults to 8080)
PORT=8080
